# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/slicehub

# JWT (generate strong secrets before production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=slicehub_token
JWT_ADMIN_COOKIE_NAME=slicehub_admin_token
JWT_COOKIE_MAX_AGE_MS=604800000

# Email (Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="SliceHub <noreply@slicehub.com>"

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Cart pricing (server-authoritative)
CART_DELIVERY_FEE=49
CART_FREE_DELIVERY_MIN=999
CART_TAX_RATE=0.05

# Razorpay TEST MODE only (never commit real secrets)
# Dashboard → https://dashboard.razorpay.com/app/keys (Test Mode toggle ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
PAYMENT_EXPIRY_MINUTES=30

# Inventory alerts (Nodemailer + node-cron)
ADMIN_ALERT_EMAIL=admin@slicehub.com
INVENTORY_ALERT_COOLDOWN_HOURS=12
INVENTORY_CRON=0 * * * *
