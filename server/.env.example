# Server
NODE_ENV=development
PORT=5000
# Frontend origin used in verification / password-reset email links.
# Local default matches Vite (port 5173, host: true in client/vite.config.js).
# localhost only works on THIS machine. For phone/other device testing, set
# CLIENT_URL to your LAN URL, e.g. http://192.168.x.x:5173 (and open the firewall).
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/slicehub

# JWT (REQUIRED strong unique secret in production — server refuses weak defaults)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=slicehub_token
JWT_ADMIN_COOKIE_NAME=slicehub_admin_token
JWT_COOKIE_MAX_AGE_MS=604800000

# Email (Nodemailer SMTP) — required for verification & password-reset emails
# Placeholder hosts like smtp.example.com will NOT send mail.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password: Google Account → Security → App passwords
#   3. Use smtp.gmail.com, port 587, and the 16-character App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="SliceHub <youraddress@gmail.com>"

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Cart pricing (server-authoritative)
CART_DELIVERY_FEE=49
CART_FREE_DELIVERY_MIN=999
CART_TAX_RATE=0.05

# Razorpay TEST MODE only (never commit real secrets)
# Dashboard → https://dashboard.razorpay.com/app/keys (Test Mode toggle ON)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
PAYMENT_EXPIRY_MINUTES=30

# Inventory alerts (Nodemailer + node-cron)
ADMIN_ALERT_EMAIL=admin@slicehub.com
INVENTORY_ALERT_COOLDOWN_HOURS=12
INVENTORY_CRON=0 * * * *

# Optional — used by `npm run seed:admin` only
# ADMIN_NAME=SliceHub Admin
# ADMIN_EMAIL=admin@slicehub.com
# ADMIN_PASSWORD=change_me_strong_password
# ADMIN_ROLE=super_admin
#
# If the admin already exists, seed does NOT change the password unless you run:
#   npm run seed:admin -- --reset-password
# or set ADMIN_PASSWORD_RESET=true for that one seed run.
# ADMIN_PASSWORD_RESET=false
